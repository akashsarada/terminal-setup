# -----------------------------------------------------------------------------
# Ghostty Terminal Configuration
# -----------------------------------------------------------------------------

# Font (matches JetBrainsMono Nerd Font in font/ directory and Windows Fonts)
font-family = "JetBrainsMono Nerd Font Mono"
font-family = "JetBrainsMono NFM"
font-size = 12

# Color Palette (pure black background matching tmux.conf)
background = #000000
foreground = #e0def4
cursor-color = #5fd7ff
selection-background = #2e3440
selection-foreground = #ffffff

# Window & Padding (tight padding for clean tmux pane rendering)
window-padding-x = 2
window-padding-y = 2
window-padding-balance = true

# Cursor
cursor-style = block
cursor-style-blink = false

# Bell (silenced to match tmux.conf bell settings)
bell-features = no-audio,no-system,no-attention,no-title,no-border

# Usability
mouse-hide-while-typing = true
confirm-close-surface = false
